// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  googleId String? @unique

  posts         Post[]
  reqTrades     Trade[]        @relation("reqTrades")
  ownedTrades   Trade[]        @relation("ownedTrades")
  comments      Comment[]
  logs          Log[]
  products      Product[]
  services      Service[]
  initiatedDMs  DM[]           @relation("initiatedDMs")
  recievedDMs   DM[]           @relation("recievedDMs")
  sMessages     Message[]      @relation("sMessages")
  rMessages     Message[]      @relation("rMessages")
  sReviews      Review[]       @relation("sReviews")
  rReviews      Review[]       @relation("rReviews")
  tradeOffers   TradeOffer[]
  media         Media[]
  userMedia     UserMedia[]
  notifications Notification[]

  name       String
  email      String   @unique
  phone      String?
  role       Role?    @default(USER)
  bio        String?
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())
  zipCode    String?
  country    String?
  lat        Float?
  lng        Float?
  termsAccepted Boolean  @default(false)

  isSystem           Boolean @default(false)
  pendingBio         String?
  isPendingScreening Boolean @default(false)
  version            Int     @default(0)

  emailVisible        Boolean @default(true)
  tradeHistoryVisible Boolean @default(true)

  reportsFiled    Report[] @relation("reportsFiled")
  reportsAgainst  Report[] @relation("reportsAgainst")
  reportsResolved Report[] @relation("reportsResolved")

  appealsFiled    Appeal[] @relation("appealsFiled")
  appealsResolved Appeal[] @relation("appealsResolved")

  blocksInitiated Block[]        @relation("blocksInitiated")
  blocksReceived  Block[]        @relation("blocksReceived")
  tradeRequests   TradeRequest[]
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model DM {
  id      Int  @id @default(autoincrement())
  user1   User @relation("initiatedDMs", fields: [user1Id], references: [id])
  user1Id Int
  user2   User @relation("recievedDMs", fields: [user2Id], references: [id])
  user2Id Int

  user1Archived Boolean @default(false)
  user2Archived Boolean @default(false)

  messages Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id         Int  @id @default(autoincrement())
  dm         DM   @relation(fields: [dmId], references: [id])
  dmId       Int
  sender     User @relation("sMessages", fields: [senderId], references: [id])
  senderId   Int
  reciever   User @relation("rMessages", fields: [recieverId], references: [id])
  recieverId Int

  text      String
  createdAt DateTime @default(now())

  reports      Report[]
  isRemoved    Boolean        @default(false)
  messageMedia MessageMedia[]
  version      Int            @default(0)

  @@index([dmId, createdAt])
}

model Log {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Post {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  products Product[]
  services Service[]
  comments Comment[]
  trades   Trade[]

  images      String[]
  status      Status       @default(OPEN)
  tradeOffers TradeOffer[]
  postMedia   PostMedia[]

  title     String
  message   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isLocal     Boolean @default(false)
  zipCode     String?
  radiusMiles Int?
  lat         Float?
  lng         Float?

  isPendingScreening Boolean  @default(false)
  isRemoved          Boolean  @default(false)
  reports            Report[]
  version            Int      @default(0)

  tradeRequests TradeRequest[]

  @@index([isRemoved, isPendingScreening])
  @@index([userId])
}

enum Status {
  OPEN
  ACCEPTED
  IN_PROGRESS
  WAITING_FOR_OTHER_USER
  COMPLETED
  CANCELLED
}

model Trade {
  id          Int  @id @default(autoincrement())
  post        Post @relation(fields: [postId], references: [id])
  postId      Int
  owner       User @relation("ownedTrades", fields: [ownerId], references: [id])
  ownerId     Int
  requester   User @relation("reqTrades", fields: [requesterId], references: [id])
  requesterId Int

  ownerCompl Boolean  @default(false)
  reqCompl   Boolean  @default(false)
  status     Status   @default(IN_PROGRESS)
  reviews    Review[]
  createdAt  DateTime @default(now())

  @@index([postId])
}

model TradeOffer {
  id        Int     @id @default(autoincrement())
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  offerer   User    @relation(fields: [offererId], references: [id], onDelete: Cascade)
  offererId Int
  message   String?

  isPendingScreening Boolean  @default(false)
  isRemoved          Boolean  @default(false)
  reports            Report[]
  version            Int      @default(0)

  tradeOfferMedia TradeOfferMedia[]

  ownerApproved   Boolean          @default(false)
  offererApproved Boolean          @default(false)
  status          TradeOfferStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([postId, status])
}

enum TradeOfferStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
}

model TradeRequest {
  id          Int  @id @default(autoincrement())
  post        Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int
  requester   User @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId Int

  message   String?
  status    TradeRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())

  isPendingScreening Boolean  @default(false)
  isRemoved          Boolean  @default(false)
  reports            Report[]
  version            Int      @default(0)

  @@unique([postId, requesterId])
}

enum TradeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int
  user         User           @relation(fields: [userId], references: [id])
  userId       Int
  parent       Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     Int?
  replies      Comment[]      @relation("CommentReplies")
  commentMedia CommentMedia[]

  isPendingScreening Boolean @default(false)
  isRemoved          Boolean  @default(false)
  reports            Report[]
  version            Int      @default(0)
}

model Product {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User @relation(fields: [userId], references: [id])
  userId Int
  cat    Cat  @relation(fields: [catId], references: [id])
  catId  Int

  name        String
  description String?
  condition   Cond
  location    String?

  productMedia ProductMedia[]
}

enum Cond {
  POOR
  AVERAGE
  GOOD
  EXCELLENT
  MINT
}

model Service {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User @relation(fields: [userId], references: [id])
  userId Int
  cat    Cat  @relation(fields: [catId], references: [id])
  catId  Int

  name        String
  description String?

  serviceMedia ServiceMedia[]
}

model Cat {
  id Int @id @default(autoincrement())

  products Product[]
  services Service[]

  type CatType
  name String

  @@unique([name, type])
}

enum CatType {
  SERVICE
  PRODUCT
  DIGITAL
}

model Review {
  id         Int   @id @default(autoincrement())
  trade      Trade @relation(fields: [tradeId], references: [id])
  tradeId    Int
  reviewer   User  @relation("sReviews", fields: [reviewerId], references: [id])
  reviewerId Int
  reviewee   User  @relation("rReviews", fields: [revieweeId], references: [id])
  revieweeId Int

  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  isPendingScreening Boolean  @default(false)
  isRemoved          Boolean  @default(false)
  reports            Report[]
  version            Int      @default(0)

  @@unique([tradeId, reviewerId])
}

model Block {
  id Int @id @default(autoincrement())

  blocker   User @relation("blocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId Int
  blocked   User @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId Int

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         Int  @id @default(autoincrement())
  reporter   User @relation("reportsFiled", fields: [reporterId], references: [id])
  reporterId Int

  targetType     TargetType
  post           Post?         @relation(fields: [postId], references: [id])
  postId         Int?
  targetUser     User?         @relation("reportsAgainst", fields: [targetUserId], references: [id])
  targetUserId   Int?
  message        Message?      @relation(fields: [messageId], references: [id])
  messageId      Int?
  offer          TradeOffer?   @relation(fields: [offerId], references: [id])
  offerId        Int?
  review         Review?       @relation(fields: [reviewId], references: [id])
  reviewId       Int?
  tradeRequest   TradeRequest? @relation(fields: [tradeRequestId], references: [id])
  tradeRequestId Int?
  comment        Comment?      @relation(fields: [commentId], references: [id])
  commentId      Int?

  reason  ReportReason
  details String?

  aiScore      Float?
  aiCategories String[]
  aiRationale  String?

  status     ReportStatus @default(PENDING)
  resolution String?
  resolver   User?        @relation("reportsResolved", fields: [resolverId], references: [id])
  resolverId Int?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  appeal Appeal?

  @@index([status, createdAt])
}

model Appeal {
  id Int @id @default(autoincrement())

  report   Report @relation(fields: [reportId], references: [id])
  reportId Int    @unique

  appellant   User @relation("appealsFiled", fields: [appellantId], references: [id])
  appellantId Int

  message String

  status     AppealStatus @default(PENDING)
  resolution String?
  resolver   User?        @relation("appealsResolved", fields: [resolverId], references: [id])
  resolverId Int?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

enum AppealStatus {
  PENDING
  GRANTED
  DENIED
}

enum TargetType {
  POST
  USER
  MESSAGE
  TRADE_OFFER
  REVIEW
  TRADE_REQUEST
  COMMENT
}

enum ReportReason {
  SPAM_OR_SCAM
  INAPPROPRIATE_CONTENT
  ITEM_MISMATCH
  HARASSMENT
  AUTO_SCREENING
  OTHER
}

enum ReportStatus {
  PENDING
  APPROVED
  REMOVED
}

enum MediaVariant {
  PREVIEW
  FULL
}

model Media {
  id    Int    @id @default(autoincrement())
  s3Key String @unique

  uploader   User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId Int

  variant   MediaVariant?
  createdAt DateTime      @default(now())

  postMedia       PostMedia[]
  tradeOfferMedia TradeOfferMedia[]
  productMedia    ProductMedia[]
  serviceMedia    ServiceMedia[]
  commentMedia    CommentMedia[]
  messageMedia    MessageMedia[]
  userMedia       UserMedia[]
}

model PostMedia {
  id        Int   @id @default(autoincrement())
  media     Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  post      Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  sortOrder Int   @default(0)

  @@unique([mediaId, postId])
}

model TradeOfferMedia {
  id           Int        @id @default(autoincrement())
  media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId      Int
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  tradeOfferId Int
  sortOrder    Int        @default(0)

  @@unique([mediaId, tradeOfferId])
}

model ProductMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([mediaId, productId])
}

model ServiceMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId Int

  @@unique([mediaId, serviceId])
}

model CommentMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int

  @@unique([mediaId, commentId])
}

model MessageMedia {
  id        Int     @id @default(autoincrement())
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId   Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId Int

  @@unique([mediaId, messageId])
}

model UserMedia {
  id      Int   @id @default(autoincrement())
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  slot UserMediaSlot

  @@unique([userId, slot])
}

enum UserMediaSlot {
  AVATAR
  BANNER
}

enum NotificationType {
  DM_MESSAGE
  TRADE_OFFER_RECEIVED
  TRADE_OFFER_ACCEPTED
  TRADE_REQUEST_RECEIVED
  TRADE_REQUEST_ACCEPTED
  TRADE_PARTNER_COMPLETED
  TRADE_COMPLETED
  REVIEW_RECEIVED
  CONTENT_SCREENED
  REPORT_RESOLVED
  APPEAL_RESOLVED
  COMMENT_RECIEVED
}

model Notification {
  id     Int              @id @default(autoincrement())
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  type   NotificationType
  title  String
  body   String?
  link   String?

  entityType String?
  entityId   Int?

  readAt    DateTime?
  archivedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, archivedAt, createdAt])
}

enum JobType {
  SEND_NOTIFICATION
  SCREEN_CONTENT
}

enum JobStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED
}

model Job {
  id            Int       @id @default(autoincrement())
  type          JobType
  payload       Json
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@index([status, nextAttemptAt])
}
